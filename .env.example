APP_ENV=development
APP_NAME=TopCoach LoL

# Supabase PostgreSQL: usar direct/session pooler según el entorno.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

REDIS_URL=redis://redis:6379/0
RIOT_API_KEY=
RIOT_DEFAULT_REGION=americas

AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_STRUCTURED_OUTPUT_ENABLED=true
# Optimización opcional; el sistema debe funcionar cuando sea false.
BEDROCK_PROMPT_CACHE_ENABLED=false

VITE_API_URL=http://localhost:8000
LOG_LEVEL=INFO
